@{
    var isLoggedIn = ViewBag.IsLoggedIn;
    var menu = ViewBag.Menu;
}

<div class="headerNavbar">
    <ul class="headerNvabar">
        <a a asp-area="" asp-controller="Home" asp-action="Index" class="link_home_page_img"><li class="img-logo-header"><img src="~/image/logo.png" alt="Logo"></li></a>
        <li><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>

        @if (menu != null)
        {
            foreach (var item in menu)
            {
                <li class="menu-item">
                    <a asp-area="" asp-controller="@item.Url" asp-action="Index">@item.NamePermission</a>
                    @if (item.SubPermissions != null && item.SubPermissions.Count > 0) 
                    {
                        <ul class="submenu">
                            @foreach (var subItem in item.SubPermissions)
                            {
                                <li><a asp-area="" asp-controller="@subItem.Url" asp-action="Index">@subItem.NamePermission</a></li>
                            }
                        </ul>
                    }
                </li>
            }
        }

        @if (isLoggedIn == null || (bool)isLoggedIn == false)
        {
            <li id="SignInButtonHomePage">
                <a asp-controller="Login" asp-action="Index">Đăng nhập</a>
            </li>
        }
        else
        {
            <form class="formLogout" asp-action="Logout" asp-controller="Account" method="post">
                <li id="RegisterButtonHomePage">
                    <button type="submit" id="RegisterButtonHomePage">
                        Đăng Xuất
                    </button>
                </li>
            </form>
        }
    </ul>
</div>

