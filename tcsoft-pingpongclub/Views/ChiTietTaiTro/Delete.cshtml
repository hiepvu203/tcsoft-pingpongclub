@model tcsoft_pingpongclub.Models.Sponor

@{
    ViewData["Title"] = "Delete";
}

<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<h3>Bạn có chắc muốn xóa phiếu thu chi này?</h3>
<div class="form-container-VH">
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="IdSponor" class="control-label">Nhà tài trợ</label>
            <select asp-for="IdSponor" class="form-control-VH" asp-items="ViewBag.IdSponor" disabled></select>
        </div>
        <div class="form-group-VH">
            <label asp-for="IdTournament" class="control-label">Giải đấu</label>
            <select asp-for="IdTournament" class="form-control-VH" asp-items="ViewBag.IdTournament" disabled></select>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label for="CreatedDate" class="control-label">Ngày tạo</label>
            <input asp-for="CreatedDate" class="form-control-VH" type="date" readonly />
        </div>
        <div class="form-group-VH">
            <label asp-for="Money" class="control-label"></label>
            <input asp-for="Money" class="form-control-VH" readonly />
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label for="Other" class="control-label">Ghi chú</label>
            <input asp-for="Other" class="form-control-VH" readonly />
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdSponorTour" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
    </form>
</div>
