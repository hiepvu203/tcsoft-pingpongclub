@model tcsoft_pingpongclub.Models.Sponor

@{
    ViewData["Title"] = "Edit";
}
<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<form asp-action="Edit" class="form-container-VH">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdSponorTour" />
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="Money" class="control-label"></label>
            <input asp-for="Money" class="form-control-VH" />
            <span asp-validation-for="Money" class="text-danger"></span>
        </div>
        <div class="form-group-VH">
            <label asp-for="IdTournament" class="control-label"></label>
            <select asp-for="IdTournament" class="form-control-VH" asp-items="ViewBag.IdTournament"></select>
            <span asp-validation-for="IdTournament" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="IdSponor" class="control-label"></label>
            <select asp-for="IdSponor" class="form-control-VH" asp-items="ViewBag.IdSponor"></select>
            <span asp-validation-for="IdSponor" class="text-danger"></span>
        </div>
        <div class="form-group-VH">
            <label for="CreatedDate" class="control-label">Ngày tạo</label>
            <input asp-for="CreatedDate" class="form-input-VH" type="date" />
            <span asp-validation-for="CreatedDate" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="Other" class="control-label"></label>
            <input asp-for="Other" class="form-control-VH" />
            <span asp-validation-for="Other" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
