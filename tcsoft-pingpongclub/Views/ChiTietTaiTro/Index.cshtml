@model IEnumerable<tcsoft_pingpongclub.Models.Sponor>

@{
    ViewData["Title"] = "Index";
}

<link href="~/css/expenseandincome.css" rel="stylesheet" />

<div class="container">
    <div class="main-feture">
        <div class="dropdown-container">
            <button class="dropdown-btn">Options</button>
            <div class="dropdown-content">
                <a asp-area="" asp-controller="ExpenseAndIncome" asp-action="Index">Tài chính</a>
                <a asp-area="" asp-controller="NhaTaiTro" asp-action="Index">Nhà tài trợ</a>
                <a asp-area="" asp-controller="Reason" asp-action="Index">Lý do</a>
                <a asp-area="" asp-controller="ChiTietTaiTro" asp-action="Index">Chi tiết tài trợ</a>
                <a asp-area="" asp-controller="Statistics" asp-action="Index">Thống kê</a>
            </div>
        </div>

        <div class="actions">
            <a asp-action="Search" class="btn-primary">Tìm kiếm</a>
            <a asp-action="Index" class="btn-primary">Làm mới</a>
            <a class="btn-primary" asp-action="Create">Thêm mới</a>
        </div>
    </div>

    <!-- Table -->
    <table class="custom-table">
        <thead>
            <tr>
                <th>Mã tài trợ</th>
                <th>Mã thu chi</th>
                <th>Giải đấu</th>
                <th>Nhà tài trợ</th>
                <th>Tiền tài trợ</th>
                <th>Ghi chú</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdSponorTour)</td>
                    <td>@Html.DisplayFor(modelItem => item.IdIncome)</td>
                    <td>@Html.DisplayFor(modelItem => item.IdTournamentNavigation.TournamentName)</td>
                    <td>@Html.DisplayFor(modelItem => item.IdSponorNavigation.NameSponer)</td>
                    <td>@item.Money.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                    <td>@Html.DisplayFor(modelItem => item.Other)</td>
                    <td>
                        <a class="btn-warning" asp-action="Edit" asp-route-id="@item.IdSponorTour">Sửa</a>
                        <a class="btn-danger" asp-action="Delete" asp-route-id="@item.IdSponorTour">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
