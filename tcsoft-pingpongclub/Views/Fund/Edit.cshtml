@model tcsoft_pingpongclub.Models.Fund

@{
    ViewData["Title"] = "Edit";
}
<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>
<form asp-action="Edit" class="form-container-VH">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdFund" />
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="FundName" class="control-label"></label>
            <input asp-for="FundName" class="form-control-VH" />
            <span asp-validation-for="FundName" class="text-danger"></span>
        </div>
        <div class="form-group-VH">
            <label asp-for="Total" class="control-label"></label>
            <input asp-for="Total" class="form-control-VH" />
            <span asp-validation-for="Total" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="Status" class="control-label">Trạng thái</label>
            <select asp-for="Status" asp-items="ViewBag.Status" class="form-control-VH"></select>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}