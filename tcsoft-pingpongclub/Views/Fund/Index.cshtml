@model IEnumerable<tcsoft_pingpongclub.Models.Fund>

@{
    ViewData["Title"] = "Index";
}

<link href="~/css/expenseandincome.css" rel="stylesheet" />

<div class="VuHiep-container">
    <div class="main-feture-VH">
        <div class="dropdown-container-VH">
            <button class="dropdown-btn-VH">Options</button>
            <div class="dropdown-content-VH">
                <a asp-area="" asp-controller="ExpenseAndIncome" asp-action="Index">Tài chính</a>
                <a asp-area="" asp-controller="NhaTaiTro" asp-action="Index">Nhà tài trợ</a>
                <a asp-area="" asp-controller="ChiTietTaiTro" asp-action="Index">Chi tiết tài trợ</a>
                <a asp-area="" asp-controller="Reason" asp-action="Index">Lý do</a>
                <a asp-area="" asp-controller="Fund" asp-action="Index">Qũy</a>
            </div>
        </div>

        <div class="actions-VH">
            <a class="btn-primary-VH" asp-action="Create">Thêm mới</a>
        </div>
    </div>

    <table class="custom-table-VH">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên quỹ</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Hoạt động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdFund)</td>
                    <td>@Html.DisplayFor(modelItem => item.FundName)</td>
                    <td>@item.Total.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                    <td>@(item.Status == true ? "Hoạt động" : "Ngừng")</td>
                    <td>
                        <a class="btn-warning-VH" asp-action="Edit" asp-route-id="@item.IdFund">Sửa</a>
                        <a class="btn-danger-VH" asp-action="Delete" asp-route-id="@item.IdFund">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
