<style>

    h1 {
        color: #333;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .Search {
        background-color: #fff;
        
    }

    .dateSearch label {
        font-weight: bold;
        color: #555;
    }

    .dateSearch input[type="date"] {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px 10px;
        font-size: 1rem;
    }

    .dateSearch button {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
    }

        .dateSearch button:hover {
            background-color: #218838;
        }

    .Match {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .FeaturedMatch {
        background-color: #fff;
        border-radius: 8px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .table th, .table td {
            border: 1px solid #ddd;

            text-align: center;
        }

        .table th {
            background-color: #f4f4f4;
            font-weight: bold;
            color: #333;
        }

</style>


<h1 class="mt-5 text-center">@ViewBag.Tour.TournamentName</h1>

<div class="">
    <div class="Search d-flex justify-content-end">
        <form asp-action="MatchClient" class="d-flex flex-row justify-content-center mb-5">
 
            <div class="dateSearch me-5">
                <label class="mb-2">Ngày thi đấu</label> <br />
                <input type="date" style="width:200px" name="TimeSearch" min="@ViewBag.Tour.TimeStart.ToString("yyyy-MM-dd")" max="@ViewBag.Tour.TimeEnd.ToString("yyyy-MM-dd")" value="@ViewBag.TimeSearch.ToString("yyyy-MM-dd")" />
            </div>
            <div class="dateSearch me-5">
                <button type="submit" class="btn btn-success mt-4">Tìm kiếm</button>
            </div>
        </form>
    </div>

    @if(ViewBag.ResultSearch == null)
