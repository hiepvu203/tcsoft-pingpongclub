@model tcsoft_pingpongclub.Models.Match

@{
    ViewData["Title"] = "Chỉnh sửa thời gian trận đấu";
}
<h1 class="text-center">Điều chỉnh thời gian</h1>
<hr />
<div class="container text-center py-4 bg-white text-dark containerTien">
    <form asp-action="Edit" class="mt-4 formTien">
        <h4>@ViewBag.nameTour</h4>
        <div class="row align-items-center contentTien">
            <!-- Team 1 -->
            <div class="col-md-4 playerTien d-flex  flex-sm-row align-items-center">
                <img src="~/image/@(ViewBag.urlPlayer1)" alt="Ảnh người chơi 1" class="imgTien">
                <h5 class="mt-2">@ViewBag.playerName1</h5>
            </div>

            <div class="form-group col-md-4 timeTien">
                <label asp-for="TimeStart" class="form-label">Thời gian bắt đầu</label>
                <input asp-for="TimeStart" class="form-control text-center timeInputTien">
                <span asp-validation-for="TimeStart" class="text-danger"></span>
            </div>

            <div class="col-md-4 playerTien d-flex  align-items-center flex-sm-row">
                <img src="~/image/@(ViewBag.urlPlayer2)" alt="Ảnh người chơi 2" class="imgTien">
                <h5 class="mt-2">@ViewBag.playerName2</h5>
            </div>
        </div>
        <input type="hidden" asp-for="IdMatch">
