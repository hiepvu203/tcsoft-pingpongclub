@model tcsoft_pingpongclub.Models.Match

@{
    ViewData["Title"] = "Chỉnh sửa các set đấu";
    List<string> SetPoints = ((IEnumerable<string>)ViewBag.SetPoints).ToList();
    var i = 1;
}
<h1 class="text-center">Điều chỉnh tỉ số</h1>
<hr />
<div class="container text-center py-4 bg-white text-dark">
    <form asp-action="EditSet" class="mt-4">

        <h1>@ViewBag.nameTour</h1>
        <div class="row align-items-center">
            <div class="col-md-4">
                <img src="~/image/@(ViewBag.urlPlayer1)" alt="Ảnh người chơi 1" class="img-fluid" style="width: 100px;border-radius:100px;">
                <h5 class="mt-2">@ViewBag.playerName1</h5>
            </div>

            <div class="col-md-4">
                <h3>Thời gian thi đấu</h3>
                <h5 class="mt-2">@ViewBag.MatchTime.ToString("hh:mm tt dd/MM/yyyy")</h5>
            </div>
            <div class="col-md-4">
                <img src="~/image/@(ViewBag.urlPlayer2)" alt="Ảnh người chơi 2" class="img-fluid" style="width: 100px; border-radius:100px;">
                <h5 class="mt-2">@ViewBag.playerName2</h5>
            </div>
        </div>
        <div class="row align-items-center">
            @{
                int index = 1;
            }
            @foreach (var item in SetPoints)
            {
                var points = item.Split(" - ");
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary fw-bold">Set @i</h1>

                            <div class="d-flex justify-content-center align-items-center mt-2">
                                <input type="number" name="point@(index)" id="point@(index)"
                                       class="form-control text-center me-2"
                                       style="max-width: 100px;" value="@points[0]" />
                                <span class="mx-2">-</span>
                                <input type="number" name="point@(index + 1)" id="point@(index + 1)"
                                       class="form-control text-center ms-2"
                                       style="max-width: 100px;" value="@points[1]" />
                            </div>
                        </div>
                    </div>
                </div>

                i++;
                index += 2;
            }
        </div>
        <input type="hidden" name="id" value="@ViewBag.idMatch">
        <div class="d-flex mt-5 justify-content-center">
            <button type="submit" class="btn btn-primary  me-2" id="sendRatio">Lưu</button>
            <a asp-controller="Matches" class=" btn btn-danger" style="width:fit-content" asp-action="Index" asp-route-id="@ViewBag.Id">Trở lại</a>

        </div>
       
    </form>
</div>
<div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
