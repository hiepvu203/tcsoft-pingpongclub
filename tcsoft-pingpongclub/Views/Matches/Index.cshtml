@model IEnumerable<tcsoft_pingpongclub.Models.MatchAndPlayer>

<h1 class="text-center">@ViewBag.NameTour</h1>
<div class="container my-5 d-flex flex-wrap">

    <div class="containerMatch flex-fill me-3">
        <table class="table table-bordered  align-middle tblMatch">
            <thead class="table-light">
                <tr>
                    <th class="text-center" colspan="3">
                        <span class="h4 text-primary">Danh sách Trận Đấu</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="parent setHidden">
                        @if (item.Points1 > item.Points2)
                        {
                            <td class="text-center bg-cyan-300 text-white playerWin" >

                                @Html.DisplayFor(modelItem => item.PlayerName1)
                                <img src="~/image/@(item.urlPlayer1)" alt="Player 1" class="rounded-circle ms-2 player-image">
                            </td>
                        }
                        else
                        {
                            <td class="text-center bg-light player"">

                                @Html.DisplayFor(modelItem => item.PlayerName1)
                                <img src="~/image/@(item.urlPlayer1)" alt="Player 1" class="rounded-circle ms-2 player-image">
                            </td>
                        }

                        <td class="text-center align-middle match-info">
                            @if (item.TimeStart == null)
                            {
                                <a asp-action="Edit" asp-route-id="@item.IdMatch" class="badge bg-danger px-3 py-2 text-decoration-none">Chưa có lịch thi đấu</a>
                            }
                            else
                            {
                                @if (item.Points2 > item.Points1)
                                {
                                    <div>
                                        <span class="fw-bold fs-4 text-danger">@Html.DisplayFor(modelItem => item.Points1)</span>
                                        <span class="mx-2">-</span>
                                        <span class="fw-bold fs-4 text-success">@Html.DisplayFor(modelItem => item.Points2)</span>
                                    </div>
                                    <div class="mt-1">
                                        <a asp-action="Edit" asp-route-id="@item.IdMatch" class="badge bg-primary px-3 py-2 text-decoration-none">
                                            @(item.TimeStart?.ToString("HH:mm:ss dd-MM-yyyy"))
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <span class="fw-bold fs-4 text-success">@Html.DisplayFor(modelItem => item.Points1)</span>
                                        <span class="mx-2">-</span>
                                        <span class="fw-bold fs-4 text-danger">@Html.DisplayFor(modelItem => item.Points2)</span>
                                    </div>
                                    <div class="mt-1">
                                        <a asp-action="Edit" asp-route-id="@item.IdMatch" class="badge bg-primary px-3 py-2 text-decoration-none">
                                            @(item.TimeStart?.ToString("HH:mm:ss dd-MM-yyyy"))
                                        </a>
                                    </div>
                                }
                            }
                        </td>

                        @if (item.Points2 > item.Points1)
                        {
                            <td class="text-center bg-cyan-300 text-white playerWin" >
                                <img src="~/image/@(item.urlPlayer2)" alt="Player 2" class="rounded-circle ms-2 player-image">
                                @Html.DisplayFor(modelItem => item.PlayerName2)

                            </td>
                        }
                        else
                        {
                            <td class="text-center bg-light player" >
                                <img src="~/image/@(item.urlPlayer2)" alt="Player 2" class="rounded-circle ms-2 player-image">
                                @Html.DisplayFor(modelItem => item.PlayerName2)

                            </td>
                        }
                    </tr>

                    @if (item.ListSet.Any())
                    {
                        <tr class="child d-none">
                            @foreach (var set in item.ListSet)
                            {
                                <td class="text-center set-details">
                                    <h5 class="fw-bold">Set @Html.DisplayFor(modelItem => set.SetName)</h5>
                                    <span>@Html.DisplayFor(modelItem => set.Ratio)</span>
                                </td>
                            }
                        </tr>
                        <tr class="child1 d-none">
                            <td colspan="3" class="text-center">
                                <a asp-action="EditSet" asp-route-id="@item.IdMatch" class="badge bg-primary px-3 py-2 text-decoration-none">Chỉnh sửa set</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="child d-none">
                            <td colspan="3" class="text-center fw-bold text-danger">
                                <span>Trận đấu chưa diễn ra</span>
                            </td>
                        </tr>
                        <tr class="child1 d-none">
                            <td colspan="3" class="text-center">
                                <a asp-action="EditSet" asp-route-id="@item.IdMatch" class="badge bg-secondary px-3 py-2 text-decoration-none">Chỉnh sửa set đấu</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="rankMatch flex-fill">
        <table class="table table-bordered table-striped align-middle tblRank">
            <thead class="table-light">
                <tr>
                    <th class="text-center">
                        <span class="h4 text-primary">Vị trí</span>
                    </th>
                    <th class="text-center">
                        <span class="h4 text-primary">Tên người chơi</span>
                    </th>
                    <th class="text-center">
                        <span class="h4 text-primary">Số trận thắng</span>
                    </th>
                </tr>
            </thead>        
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in ViewBag.RankTour)
                {
                    <tr class="parent">
                        <td class="text-center">@index</td>
                        <td class="text-center">@item.NamePlayer</td>
                        <td class="text-center">@item.CountMatch</td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>






