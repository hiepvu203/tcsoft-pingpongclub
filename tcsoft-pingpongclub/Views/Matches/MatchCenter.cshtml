    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    var Match = ViewBag.Match;
}
<div class="my-5 d-flex containerCenter">
    <div class="row border border-secondary-subtle matchCenter">
        <div class="col m-auto d-flex flex-column player">
            <img class="rounded-circle align-self-center" src="~/image/@(ViewBag.Match.urlPlayer1)" alt="Ảnh người chơi 1" />
            <h3 class="align-self-center">@Match.PlayerName1</h3>
        </div>
        <div class="col d-flex flex-column matchInfor">
            <h1 class="text-center">@Match.NameTour</h1>
            @if (Match.TimeStart?.Date == DateTime.Now.Date)
            {
                <p class="bg-danger text-white text-center rounded-pill align-self-center" id="live">LIVE</p>
            }
            else
            {
                <p class="text-black text-center align-self-center" id="time">@Match.TimeStart?.ToString("hh:mm dd/MM/yyyy")</p>
            }

            <p class="text-center" id="pts" class="score">@Match.Points1 - @Match.Points2</p>
        </div>
        <div class="col m-auto d-flex flex-column player">
            <img class="rounded-circle align-self-center" src="~/image/@(ViewBag.Match.urlPlayer2)" alt="Ảnh người chơi 2" />
            <h3 class="align-self-center">@Match.PlayerName2</h3>
        </div>

        <div class="row mb-4">
            @{
                int i = 1;
            }
            @foreach (var item in Match.ListSet)
            {
                <div class="col-md-4 setCenter">
                    <div class="card ">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary fw-bold">Set @i</h1>
                            <div class="d-flex justify-content-center align-items-center mt-2">
                                <p id="ratio@(i)" class="set-ratio">@item.Ratio</p>
                            </div>
                        </div>
                    </div>
                </div>
                i++;
            }
        </div>

        <a asp-controller="Matches" class="d-block m-auto mb-2 btn btn-danger" style="width: 20%;" asp-action="MatchClient" asp-route-id="@Match.IdTour">Trở lại</a>
    </div>

    <div class="tblCenter">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <td colspan="3" class="font-weight-bold fs-4">Trận đấu trong ngày</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in ViewBag.todayMatches)
                {
                    <tr>
                        <td colspan="3" class="text-start font-weight-bold fs-3">@match.Date?.ToString("dd/MM/yyyy")</td>
                    </tr>
                    @foreach (var item in match.Matches)
                    {
                        <tr class="parent setHidden">
                            @if (item.Points1 > item.Points2)
                            {
                                <td class="text-center bg-cyan-300 text-white player-name">@item.PlayerName1</td>
                            }
                            else
                            {
                                <td class="text-center bg-light player-name">@item.PlayerName1</td>
                            }

                            <td class="text-center align-middle match-info">
                                @if (item.TimeStart == null)
                                {
                                    <p class="badge bg-danger px-3 py-2 text-decoration-none">Chưa có lịch thi đấu</p>
                                }
                                else
                                {
                                    @if (item.Points2 > item.Points1)
                                    {
                                        <div>
                                            <span class="fw-bold fs-4 text-danger">@item.Points1</span>
                                            <span class="mx-2">-</span>
                                            <span class="fw-bold fs-4 text-success">@item.Points2</span>
                                        </div>
                                        <div class="mt-1">
                                            <p class="badge bg-primary px-3 py-2 text-decoration-none">@item.TimeStart?.ToString("HH:mm")</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="fw-bold fs-4 text-success">@item.Points1</span>
                                            <span class="mx-2">-</span>
                                            <span class="fw-bold fs-4 text-danger">@item.Points2</span>
                                        </div>
                                        <div class="mt-1">
                                            <p class="badge bg-primary px-3 py-2 text-decoration-none">@item.TimeStart?.ToString("HH:mm")</p>
                                        </div>
                                    }
                                }
                            </td>

                            @if (item.Points2 > item.Points1)
                            {
                                <td class="text-center bg-cyan-300 text-white player-name">@item.PlayerName2</td>
                            }
                            else
                            {
                                <td class="text-center bg-light player-name">@item.PlayerName2</td>
                            }
                        </tr>

                        @if (item.ListSet != null && item.ListSet.Count > 0)
                        {
                            <tr class="child d-none">
                                @foreach (var set in item.ListSet)
                                {
                                    <td class="text-center">
                                        <h5 class="fw-bold">Set @set.SetName</h5>
                                        <span>@set.Ratio</span>
                                    </td>
                                }
                            </tr>
                            <tr class="child1 d-none">
                                <td colspan="3" class="text-center">
                                    <a asp-action="MatchCenter" asp-route-id="@item.IdMatch" class="badge bg-secondary px-3 py-2 text-decoration-none">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="child d-none">
                                <td colspan="3" class="text-center fw-bold text-danger">
                                    <span>Trận đấu chưa diễn ra</span>
                                </td>
                            </tr>
                            <tr class="child1 d-none">
                                <td colspan="3" class="text-center">
                                    <a asp-action="MatchCenter" asp-route-id="@item.IdMatch" class="badge bg-secondary px-3 py-2 text-decoration-none">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
    