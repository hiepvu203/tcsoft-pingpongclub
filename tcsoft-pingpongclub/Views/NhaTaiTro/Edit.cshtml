@model tcsoft_pingpongclub.Models.NhaTaiTro

@{
    ViewData["Title"] = "Edit";
}

<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<form asp-action="Edit" enctype="multipart/form-data" class="form-container-VH">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdSponor" />

    <div class="form-row-VH">
        <div>
            <div class="form-group-VH">
                <label asp-for="NameSponer" class="control-label">Nhà tài trợ:</label>
                <input asp-for="NameSponer" class="form-control-VH" />
                <span asp-validation-for="NameSponer" class="text-danger"></span>
            </div>

            <div class="form-group-VH">
                <label asp-for="ImageFile" class="control-label">Tải logo mới</label>
                <input asp-for="ImageFile" class="form-control-VH" type="file" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
        </div>
        <div>
            <div class="form-group-VH">
                <label>Logo hiện tại</label>
                @if (!string.IsNullOrEmpty(Model.UrlLogo))
                {
                    <div>
                        <img src="~/images/@Model.UrlLogo" alt="Logo" style="max-width: 200px; max-height: 200px;" />
                    </div>
                }
                else
                {
                    <p>No logo available</p>
                }
            </div>
        </div>
    </div>

    <div class="form-group-VH">
        <input type="submit" value="Cập nhật" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}