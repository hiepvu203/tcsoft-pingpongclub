@model IEnumerable<tcsoft_pingpongclub.Models.NhaTaiTro>

@{
    ViewData["Title"] = "Danh sách nhà tài trợ";
}

<link href="~/css/expenseandincome.css" rel="stylesheet" />
<div class="container">
    <div class="main-feture">
        <div class="dropdown-container">
            <button class="dropdown-btn">Options</button>
            <div class="dropdown-content">
                <a asp-area="" asp-controller="ExpenseAndIncome" asp-action="Index">Tài chính</a>
                <a asp-area="" asp-controller="NhaTaiTro" asp-action="Index">Nhà tài trợ</a>
                <a asp-area="" asp-controller="Reason" asp-action="Index">Lý do</a>
                <a asp-area="" asp-controller="ChiTietTaiTro" asp-action="Index">Chi tiết tài trợ</a>
            </div>
        </div>

        <div class="actions">
            <a class="btn-primary" asp-action="Create">Thêm mới</a>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên nhà tài trợ</th>
                <th>Logo</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdSponor)</td>
                    <td>@Html.DisplayFor(modelItem => item.NameSponer)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.UrlLogo))
                        {
                            <img src="@Url.Content("~/images/" + item.UrlLogo)" alt="Logo" class="img-fluid" style="max-width: 100px; height: auto;" />
                        }
                        else
                        {
                            <span>Không có logo</span>
                        }
                    </td>
                    <td>
                        <a class="btn-warning" asp-action="Edit" asp-route-id="@item.IdSponor">Sửa</a>
                        <a class="btn-danger" asp-action="Delete" asp-route-id="@item.IdSponor">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
