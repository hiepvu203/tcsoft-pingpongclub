@model IEnumerable<tcsoft_pingpongclub.ViewModels.StatisticsViewModel>
<link href="~/css/expenseandincome.css" rel="stylesheet" />
<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
</div>

<h2 class="text-center-VH">Thống kê thu chi</h2>

<form method="get" asp-action="Statistics" class="form-container-VH">
    <div class="form-row-VH">
        <div class="form-group-VH" style="flex:1">
            <label for="startDate" class="form-label-VH">Từ ngày:</label>
            <input type="date" id="startDate" name="startDate" class="form-control-VH"
                   value="@ViewData["StartDate"]" required />
        </div>
        <div class="form-group-VH" style="flex:1">
            <label for="endDate" class="form-label-VH">Đến ngày:</label>
            <input type="date" id="endDate" name="endDate" class="form-control-VH"
                   value="@ViewData["EndDate"]" required />
        </div>
    </div>
    <div class="form-group-VH">
        <input type="submit" value="Lọc" class="btn-primary-VH" />
    </div>
</form>

<table class="custom-table-VH">
    <thead>
        <tr>
            <th>Quỹ</th>
            <th>Số dư đầu kỳ</th>
            <th>Tổng thu</th>
            <th>Tổng chi</th>
            <th>Số dư cuối kỳ</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stat in Model)
        {
            <tr>
                <td>@stat.FundName</td>
                <td>@stat.OpeningBalance.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                <td>@stat.TotalIncome.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                <td>@stat.TotalExpense.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                <td>@stat.ClosingBalance.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-info">
            <td><strong>Tổng cộng</strong></td>
            <td>@Model.Sum(x => x.OpeningBalance).ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
            <td>@Model.Sum(x => x.TotalIncome).ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
            <td>@Model.Sum(x => x.TotalExpense).ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
            <td>@Model.Sum(x => x.ClosingBalance).ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
        </tr>
    </tfoot>
</table>