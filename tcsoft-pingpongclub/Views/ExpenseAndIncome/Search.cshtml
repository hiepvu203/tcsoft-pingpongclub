@model tcsoft_pingpongclub.Models.ExpenseAndIncome

<link href="~/css/expenseandincomeformsearch.css" rel="stylesheet" />

<div class="container mt-5">
    <h3 class="text-center mb-4">Bộ lọc cho tiết</h3>
    <div class="card shadow-lg rounded-lg">
        <form asp-action="Search" class="p-4">
            <div class="row">
                <!-- Loại -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <label class="form-label">Loại</label>
                    <div class="d-flex">
                        <div class="form-check me-4">
                            <input type="radio" asp-for="Type" value="false" id="TypeThu" class="form-check-input" />
                            <label for="TypeThu" class="form-check-label">Thu</label>
                        </div>
                        <div class="form-check">
                            <input type="radio" asp-for="Type" value="true" id="TypeChi" class="form-check-input" />
                            <label for="TypeChi" class="form-check-label">Chi</label>
                        </div>
                    </div>
                </div>

                <!-- Quỹ -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <label for="IdFund" class="form-label">Chọn quỹ</label>
                    <select asp-for="IdFund" class="form-select" asp-items="ViewBag.IdFund"></select>
                </div>

                <!-- Thành viên -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <label for="IdParty" class="form-label">Thành viên</label>
                    <select asp-for="IdParty" class="form-select" asp-items="ViewBag.IdParty"></select>
                </div>

                <!-- Lý do -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <label for="IdReason" class="form-label">Lý do</label>
                    <select asp-for="IdReason" class="form-select" asp-items="ViewBag.IdReason"></select>
                </div>

                <!-- Ngày tạo -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <label for="CreatedDate" class="form-label">Ngày tạo</label>
                    <input asp-for="CreatedDate" class="form-control" type="date" />
                </div>

                <!-- Submit -->
                <div class="col-12">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </div>
            </div>
        </form>
    </div>
</div>