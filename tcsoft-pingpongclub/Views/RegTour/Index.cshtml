@model IEnumerable<tcsoft_pingpongclub.Models.Tournament>

@{
	ViewData["Title"] = "Danh sách giải đấu";
}
<style>
	a.custom-link {
		color: #007bff;
		text-decoration: none;
		font-weight: bold;
		padding: 8px 12px;
		border: 2px solid #007bff;
		border-radius: 4px;
		transition: background-color 0.3s, color 0.3s;
		display: flex;
		text-align: center;
		align-items: center;
	}

		a.custom-link:hover {
			background-color: #007bff;
			color: #fff;
		}

	.featured-tournament {
		display: flex;
		flex-direction: column;
		margin-bottom: 30px;
		transition: transform 0.3s ease, background-color 0.3s ease;
	}

	.header-container {
		margin-top: 30px;
		margin-bottom: 30px;
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
	}


	.tournament-highlight {
		display: flex;
		background-color: #f8f9fa;
		padding: 20px;
		border-radius: 10px;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
		justify-content: center;
		transition: transform 0.3s ease, background-color 0.3s ease;
	}

	.highlight-image {
		width: 40%;
		height: 400px;
	}

	.highlight-image img {
		width: 100%;
		height: 100%;
		border-radius: 10px;
		object-fit: cover;
	}

	.highlight-details {
		margin-left: 20px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 50%;
		text-align: center;
	}


		.highlight-details h2 {
			font-size: 24px;
			color: #333;
			margin-bottom: 10px;
			text-align: center;
			align-self: center;
		}


		.highlight-details p {
			color: #666;
			font-size: 16px;
			margin-bottom: 15px;
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.highlight-details .btn {
			width: fit-content;
		}

	.other-tournaments {
		display: flex;
		justify-items: center;
		justify-content: space-between;
	}

	.tournament-item {
		background-color: white;
		border-radius: 8px;
		box-shadow: 0 2px 10px rgba(0, 10, 0, 0.1);
		padding: 15px;
		text-align: center;
		transition: transform 0.3s ease, background-color 0.3s ease;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.tournament-img {
		width: 250px;
		height: 150px;
		margin-right: 15px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #f8f9fa;
		border-radius: 5px;
		overflow: hidden;
	}

	.tournament-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 5px;
	}


	.tournament-info {
		width: 25%;
		text-align: left;
	}

	.tournament-item h4 {
		font-size: 18px;
		color: #333;
		margin-bottom: 5px;
	}

	.tournament-item p {
		font-size: 14px;
		color: #666;
		margin-bottom: 10px;
	}

	.tournament-item .btn {
		font-size: 14px;
		padding: 5px 10px;
	}

	.tournament-item:hover {
		transform: translateY(-5px);
		background-color: #e6f2ff;
	}

	.tournament-description {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		width: 100%;
		font-size: 14px;
		color: #666;
		margin-bottom: 10px;
	}


	.tournament-link {
		display: flex;
		text-decoration: none;
		color: inherit;
		align-items: center;
	}

		.tournament-link:hover {
			text-decoration: underline;
		}
</style>

<div class="header-container">
	<h2>GIẢI ĐẤU BÓNG BÀN</h2>
</div>
<div class="d-flex justify-content-between mb-5">

	<!-- Form Lọc Rank -->
	<form method="get" action="@Url.Action("Index")" class="me-auto">
		<select name="selectedLevel" class="form-control">
			<option value="" selected="@ViewBag.SelectedLevel">--Chọn cấp bậc--</option>
			@foreach (var level in ViewBag.Levels)
			{
				var isSelected = level.IdLevel == ViewBag.SelectedLevel ? "selected" : "";
				<option value="@level.IdLevel">@level.LevelName</option>
			}
		</select>
		<button type="submit" class="btn btn-primary mt-2">Lọc theo Rank</button>
	</form>
	<!-- Form Tìm kiếm -->
	<form method="get" action="@Url.Action("Index")" class="ms-auto">
		<input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control"
			placeholder="Tìm kiếm theo tên giải đấu" />
		<button type="submit" class="btn btn-primary mt-2">Tìm kiếm</button>
	</form>
</div>


<div class="featured-tournament">
	<!-- Hiển thị giải đấu mới nhất -->
	@if (Model.Any())
	{
		var newestTournament = Model.First();
		<div class="tournament-highlight">
			<a href="@Url.Action("Details", new { id = newestTournament.IdTournament })" class="tournament-link">
				<div class="highlight-image">
					<img src="@(newestTournament.UrlImage ?? "defaultImage.jpg")" alt="Featured Tournament" />
				</div>
				<div class="highlight-details">
					<h2>@newestTournament.TournamentName</h2>
					<p class="tournament-description">@newestTournament.Infor</p> <!-- Truncated description -->
				</div>
			</a>
		</div>
	}
</div>

<div class="other-tournaments">
	<!-- Hiển thị các giải đấu còn lại -->
	@foreach (var item in Model.Skip(1))
	{
		<div class="tournament-item">
			<a href="@Url.Action("Details", new { id = item.IdTournament })" class="tournament-link">
				<div class="tournament-img">
					<img src="@(item.UrlImage ?? "defaultImage.jpg")" alt="Tournament" />
				</div>
				<div class="tournament-info">
					<h4>@item.TournamentName</h4>
					<p class="tournament-description">@item.Infor</p> <!-- Truncated description -->
				</div>
			</a>
		</div>
	}
</div>

<div class="text-center mt-4">
	<!-- Hiển thị phân trang -->
	<ul class="pagination">
		@if (ViewBag.CurrentPage > 1)
		{
			<li class="page-item">
				<a class="page-link" href="@Url.Action("Index", new { page = 1, searchTerm = ViewBag.SearchTerm })">Trang
					đầu</a>
			</li>
			<li class="page-item">
				<a class="page-link"
					href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchTerm = ViewBag.SearchTerm })">Trang
					trước</a>
			</li>
		}

		@for (int i = 1; i <= ViewBag.TotalPages; i++)
		{
			<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
				<a class="page-link" href="@Url.Action("Index", new { page = i, searchTerm = ViewBag.SearchTerm })">@i</a>
			</li>
		}

		@if (ViewBag.CurrentPage < ViewBag.TotalPages)
		{
			<li class="page-item">
				<a class="page-link"
					href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchTerm = ViewBag.SearchTerm })">Trang
					sau</a>
			</li>
			<li class="page-item">
				<a class="page-link"
					href="@Url.Action("Index", new { page = ViewBag.TotalPages, searchTerm = ViewBag.SearchTerm })">Trang
					cuối</a>
			</li>
		}
	</ul>
</div>

