@{
    ViewBag.Title = "Nhập Email";
}

<h2>Nhập Email để lấy mã xác minh</h2>

<!-- Hiển thị thông báo lỗi hoặc thành công -->
@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <p class="error">@ViewBag.Error</p>
}
@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <p class="success">@ViewBag.Message</p>
}

<!-- Form nhập email -->
@using (Html.BeginForm("Identify", "Login", FormMethod.Post))
{
    <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required placeholder="Nhập email của bạn" class="input-box" />
    </div>
    <br />
    <button type="submit" class="submit-btn">Gửi mã xác minh</button>
}

<!-- CSS -->
<style>
    body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        background-color: #f9f9f9;
        padding: 20px;
        margin: 0;
    }

    h2 {
        color: #333;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .input-box {
        width: 100%;
        padding: 10px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
    }

        .input-box:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

    .submit-btn {
        display: block;
        width: 100%;
        padding: 10px;
        font-size: 16px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-align: center;
    }

        .submit-btn:hover {
            background-color: #0056b3;
        }

    .error {
        color: red;
        font-weight: bold;
        text-align: center;
    }

    .success {
        color: green;
        font-weight: bold;
        text-align: center;
    }
</style>

