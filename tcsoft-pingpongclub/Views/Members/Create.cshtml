@model tcsoft_pingpongclub.Models.Member
<div class="form-create-edit">
    <div class="title-edit">
        <h4>Thêm thành viên</h4>
    </div>
    <hr />
    <div class="form-editMember">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label>Nhập tên thành viên</label>
                <input asp-for="MemberName" class="form-control" />
                <span asp-validation-for="MemberName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Chọn ảnh</label>
                <input type="file" asp-for="ImageFile" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Điện thoại</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Emaill" class="form-control" />
                <span asp-validation-for="Emaill" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Giới tính</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">--Chọn giới tính--</option>
                    <option value="True">Nam</option>
                    <option value="False">Nữ</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Mức rank</label>
                <select asp-for="IdLevel" class ="form-control" asp-items="ViewBag.IdLevel"></select>
            </div>
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Quyền hạn</label>
                <select asp-for="IdRole" class ="form-control" asp-items="ViewBag.IdRole"></select>
            </div>
            <div class="button-group">
                <div class="btn-savemember">
                    <input type="submit" value="Thêm thành viên" />
                </div>
                <div class="btn-backtolist">
                    <a asp-action="Index">Trở lại</a>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}