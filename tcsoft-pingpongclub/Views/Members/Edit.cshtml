@model tcsoft_pingpongclub.Models.Member
<div class="form-create-edit">
    <div class="title-edit">
        <h4>Chỉnh sửa thông tin thành viên</h4>
    </div>
    <hr />
    <div class="form-editMember">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdMember" />
            <div class="form-group">
                <label>Chọn ảnh</label>
                <img class="avatar-member" src="@Model.LinkAvatar" />
                <input type="file" asp-for="ImageFile" class="form-control" />
            </div>
            <div class="form-group">
                <label>Tên thành viên</label>
                <input asp-for="MemberName"/>
                <span asp-validation-for="MemberName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="Address"/>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Điện thoại</label>
                <input asp-for="Phone"/>
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Emaill"/>
                <span asp-validation-for="Emaill" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Giới tính</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">--Chọn giới tính--</option>
                    <option value="True">Nam</option>
                    <option value="False">Nữ</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Mức rank</label>
                <select asp-for="IdLevel" asp-items="ViewBag.IdLevel"></select>
                <span asp-validation-for="IdLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Chức vụ</label>
                <select asp-for="IdRole" asp-items="ViewBag.IdRole"></select>
                <span asp-validation-for="IdRole" class="text-danger"></span>
            </div>
            <div class="button-group">
                <div class="btn-savemember">
                    <input type="submit" value="Lưu chỉnh sửa" />
                </div>
                <div class="btn-resetpassword">
                    <a asp-action="ResetPassword" asp-route-id="@Model.IdMember">Khôi phục mật khẩu</a>
                </div>
                <div class="btn-backtolist">
                    <a asp-action="Index">Trở lại</a>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}