@model IEnumerable<tcsoft_pingpongclub.Models.Member>
@using X.PagedList.Mvc.Core
@using X.PagedList
<div class="btn-addmember">
    <a asp-action="Create">Thêm thành viên</a>
</div>
<table class="member-list">
    <thead>
        <tr>
            <th>Tên thành viên</th>
            <th>Địa chỉ</th>
            <th>Điện thoại</th>
            <th>Email</th>
            <th>Giới tính</th>
            <th>Hạng</th>
            <th>Chức vụ</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.LinkAvatar" class="avatar-member" />
                    @Html.DisplayFor(modelItem => item.MemberName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Emaill)
                </td>
                <td>
                    @{
                        string gender;
                        if (item.Gender.Value)
                        {
                            gender = "Nam";
                        }
                        else
                        {
                            gender = "Nữ";
                        }
                    }
                    @Html.DisplayFor(modelItem => gender)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdLevelNavigation.LevelName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdRoleNavigation.NameRole)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdMember">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdMember">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center-TT">
    @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }))
</div>