@model IEnumerable<tcsoft_pingpongclub.Models.Tournament>
@{
    ViewData["Title"] = "Home Page"; // Đặt tiêu đề cho trang
    Layout = "_Layout"; // Chỉ định layout sử dụng
}
<div class="">
    <div>
        <img src="~/image/anhhomepage.jpg" class="ImageHomePage">
    </div>
    <marquee behavior="scroll" direction="left">
        <div class="TCSoftHomePage">
            <h1>TC SOFT CLUB </h1>
            <h1>TC SOFT CLUB </h1>
            <h1>TC SOFT CLUB </h1>
            <h1>TC SOFT CLUB </h1>
            <h1>TC SOFT CLUB </h1>
        </div>
    </marquee>
    <div class="tintucGiaidau">
        <div class="">
            <h1>Giải Đấu Mới Nhất</h1>

            <div class="tournaments-container">
                @if (Model != null && Model is IEnumerable<tcsoft_pingpongclub.Models.Tournament> tournaments && tournaments.Any())
                {
                    foreach (var tournament in tournaments)
                    {
                        <div class="MainTourOnHomePage">
                            <img src="@tournament.UrlImage" alt="Tour Image">
                            <div class="content">
                                <h2>@tournament.TournamentName</h2>
                                <p>Thời gian bắt đầu: @(tournament.TimeStart?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")
                                </p>
                                <p>Thời gian kết thúc: @(tournament.TimeEnd?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")
                                </p>
                                <p>Thông tin: @tournament.Infor</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Không có giải đấu nào được hiển thị.</p>
                }
            </div>
        </div>
    </div>
</div>

