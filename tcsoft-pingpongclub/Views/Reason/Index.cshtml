@model IEnumerable<tcsoft_pingpongclub.Models.Reason>

@{
    ViewData["Title"] = "Index";
}
<link href="~/css/expenseandincome.css" rel="stylesheet" />
<div class="container">
    <div class="main-feture">
        <div class="dropdown-container">
            <button class="dropdown-btn">Options</button>
            <div class="dropdown-content">
                <a asp-area="" asp-controller="ExpenseAndIncome" asp-action="Index">Tài chính</a>
                <a asp-area="" asp-controller="NhaTaiTro" asp-action="Index">Nhà tài trợ</a>
                <a asp-area="" asp-controller="Reason" asp-action="Index">Lý do</a>
                <a asp-area="" asp-controller="ChiTietTaiTro" asp-action="Index">Chi tiết tài trợ</a>
                <a asp-area="" asp-controller="Statistics" asp-action="Index">Thống kê</a>
            </div>
        </div>

        <div class="actions">
            <a class="btn-primary" asp-action="Create">Thêm mới</a>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên lý do</th>
                <th>Loại</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdReason)</td>
                    <td>@Html.DisplayFor(modelItem => item.ReasonName)</td>
                    <td>@(item.Type == true ? "Chi" : "Thu")</td>
                    <td>
                        <a class="btn-warning" asp-action="Edit" asp-route-id="@item.IdReason">Sửa</a>
                        <a class="btn-danger" asp-action="Delete" asp-route-id="@item.IdReason">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
