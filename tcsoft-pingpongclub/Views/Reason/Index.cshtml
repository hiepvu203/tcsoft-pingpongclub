@model IEnumerable<tcsoft_pingpongclub.Models.Reason>
@using X.PagedList.Mvc.Core
@using X.PagedList

@{
    ViewData["Title"] = "Index";
}
<link href="~/css/expenseandincome.css" rel="stylesheet" />
<div class="VuHiep-container">
    <div class="main-feture-VH">
        <div class="dropdown-container-VH">
            <button class="dropdown-btn-VH">Options</button>
            <div class="dropdown-content-VH">
                <a asp-area="" asp-controller="ExpenseAndIncome" asp-action="Index">Tài chính</a>
                <a asp-area="" asp-controller="NhaTaiTro" asp-action="Index">Nhà tài trợ</a>
                <a asp-area="" asp-controller="ChiTietTaiTro" asp-action="Index">Chi tiết tài trợ</a>
                <a asp-area="" asp-controller="Reason" asp-action="Index">Lý do</a>
                <a asp-area="" asp-controller="Fund" asp-action="Index">Qũy</a>
            </div>
        </div>

        <div class="actions-VH">
            <a class="btn-primary-VH" asp-action="Create">Thêm mới</a>
        </div>
    </div>

    <table class="custom-table-VH">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên lý do</th>
                <th>Loại</th>
                <th>Phí định kỳ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdReason)</td>
                    <td>@Html.DisplayFor(modelItem => item.ReasonName)</td>
                    <td>@(item.Type == true ? "Chi" : "Thu")</td>
                    <td>@(item.recurringFee == true ? "Có" : "Không")</td>
                    <td>
                        <a class="btn-warning-VH" asp-action="Edit" asp-route-id="@item.IdReason">Sửa</a>
                        <a class="btn-danger-VH" asp-action="Delete" asp-route-id="@item.IdReason">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center-VH">
        @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }))
    </div>
</div>
