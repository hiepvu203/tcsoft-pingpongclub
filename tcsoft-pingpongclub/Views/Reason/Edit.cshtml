@model tcsoft_pingpongclub.Models.Reason

@{
    ViewData["Title"] = "Edit";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdReason" />
            <div class="form-group">
                <label asp-for="ReasonName" class="control-label"></label>
                <input asp-for="ReasonName" class="form-control" />
                <span asp-validation-for="ReasonName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type" class="form-label">Loại</label>
                <select asp-for="Type" asp-items="ViewBag.Type" class="form-control"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
