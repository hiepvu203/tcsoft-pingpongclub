@model tcsoft_pingpongclub.Models.Reason

@{
    ViewData["Title"] = "Delete";
}
<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<h3>Bạn có chắc muốn xóa lý do này?</h3>
<div class="form-container-VH">
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label for="ReasonName" class="control-label">Lý do:</label>
            <input asp-for="ReasonName" class="form-control-VH" readonly />
        </div>
        <div class="form-group-VH">
            <label asp-for="Type" class="control-label">Loại</label>
            <select asp-for="Type" class="form-control-VH" asp-items="ViewBag.Type" disabled></select>
        </div>
    </div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="recurringFee" class="control-label">Phí định kỳ</label>
            <select asp-for="recurringFee" class="form-control-VH" asp-items="ViewBag.recurringFee" disabled></select>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdReason" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> 
    </form>
</div>