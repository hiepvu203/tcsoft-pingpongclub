@model tcsoft_pingpongclub.Models.Reason

@{
    ViewData["Title"] = "Create";
}
<link href="~/css/formcreatev2.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

<div>
    <a asp-action="Index" class="back-link-VH"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<form asp-action="Create" class="form-container-VH">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-row-VH">
        <div class="form-group-VH">
            <label asp-for="ReasonName" class="control-label">Tên lý do</label>
            <input asp-for="ReasonName" class="form-control-VH" />
            <span asp-validation-for="ReasonName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row-VH">
        <div class="form-group-VH">
            <label class="form-label-VH">Loại</label>
            <div class="radio-group">
                <input type="radio" asp-for="Type" value="false" id="TypeThu" class="form-radio" />
                <label for="TypeThu" class="radio-label">Thu</label>
            </div>
            <div class="radio-group">
                <input type="radio" asp-for="Type" value="true" id="TypeChi" class="form-radio" />
                <label for="TypeChi" class="radio-label">Chi</label>
            </div>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        <div class="form-group-VH">
            <label class="form-label-VH">Phí định kỳ</label>
            <div class="radio-group">
                <input type="radio" asp-for="recurringFee" value="false" id="recurringFeeFalse" class="form-radio" />
                <label for="recurringFeeFalse" class="radio-label">Không</label>
            </div>
            <div class="radio-group">
                <input type="radio" asp-for="recurringFee" value="true" id="recurringFeeTrue" class="form-radio" />
                <label for="recurringFeeTrue" class="radio-label">Có</label>
            </div>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group-VH">
        <input type="submit" value="Tạo" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
