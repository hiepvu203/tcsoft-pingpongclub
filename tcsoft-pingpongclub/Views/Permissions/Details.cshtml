@model tcsoft_pingpongclub.Models.Permission

@{
    ViewData["Title"] = "Details";
}
<head>
    <link rel="stylesheet" href="/css/form-detail-style.css">
</head>
<h1>@ViewData["Title"]</h1>

<div class="table-container">
    <h4>Thông tin quyền</h4>
    <hr />
    <table>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NamePermission)</th>
            <td>@Html.DisplayFor(model => model.NamePermission)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Url)</th>
            <td>@Html.DisplayFor(model => model.Url)</td>
        </tr>
        <tr>
            <th>Quyền cha</th>
            <td>
                @if (Model.ParentPermission != null)
                {
                    @Html.DisplayFor(model => model.ParentPermission.NamePermission)
                }
                else
                {
                    @:Không có quyền cha
                }
            </td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <td>
                @if (Model.Status == true)
                {
                    @:Active
                }
                else
                {
                    @:Inactive
                }
            </td>
        </tr>
    </table>
</div>

<div style="text-align:center; margin-top: 20px;">
    <a asp-action="Edit" asp-route-id="@Model?.IdPermission" class="btn-edit">Sửa</a> |
    <a asp-action="Index" class="btn-back">Quay lại danh sách</a>
</div>
