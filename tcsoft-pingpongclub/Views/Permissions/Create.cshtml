@model tcsoft_pingpongclub.Models.Permission

@{
    ViewData["Title"] = "Create";
}
<head>
    <link rel="stylesheet" href="/css/form-style.css">
</head>
<h1>@ViewData["Title"]</h1>

<h4>Permission</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NamePermission" class="control-label"></label>
                <input asp-for="NamePermission" class="form-control" />
                <span asp-validation-for="NamePermission" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                <input asp-for="Url" class="form-control" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="permission-select">Permission Cha:</label>
                <select id="permission-select" name="IdPerParent" class="form-control">
                    <option value="">-- Select Permission --</option>
                    @if (ViewBag.Permission != null)
                    {
                        @foreach (var permission in ViewBag.Permission)
                        {
                            <option value="@permission.IdPermission" data-url="@permission.Url">
                                @permission.NamePermission
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control">
                    <option value="">-- Select Status --</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
            <div class="form-group">
                <a asp-action="Index">Back to List</a>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
